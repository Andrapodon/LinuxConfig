[Unit]
Description=Seafile Drive Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="DISPLAY=:0"
Environment="WAYLAND_DISPLAY=wayland-1"
TimeoutStartSec=300
# Wait for an active internet connection at startup
ExecStartPre=/bin/sh -c 'while ! ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1; do sleep 2; done'
ExecStart=/usr/sbin/seadrive-gui

[Install]
WantedBy=default.target
